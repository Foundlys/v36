# Foundly OS v4.2.0 — Production Hardening Release
PORT=8080
FOUNDLY_PUBLIC_BASE_URL=https://v36-production.up.railway.app
FOUNDLY_ADMIN_USERNAME=foundly
FOUNDLY_ADMIN_PASSWORD=
FOUNDLY_TENANT_ID=default
FOUNDLY_DEALER_ID=default
FOUNDLY_REQUEST_TIMEOUT_MS=12000
FOUNDLY_RATE_LIMIT_PER_MINUTE=240
FOUNDLY_MAX_RECORDS_PER_SCOPE=5000
FOUNDLY_MAX_TASKS_PER_SCOPE=2000
FOUNDLY_CONNECTOR_ALLOWED_HOSTS=

# OpenAI / Foundly AI
OPENAI_API_KEY=
FOUNDLY_AI_MODEL=gpt-5.6
FOUNDLY_SEARCH_MODEL=gpt-5.6
# Optional OpenAI-compatible endpoint for normal engine chat. Web search uses OpenAI Responses API.
FOUNDLY_AI_BASE_URL=https://api.openai.com/v1

# Google OAuth Web Application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact Railway callback, e.g. https://your-service.up.railway.app/api/google/oauth/callback
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_STATE_SECRET=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Google Ads API (required for Ads + Keyword Planner search-volume layer)
GOOGLE_ADS_DEVELOPER_TOKEN=
# Optional manager account ID, digits only
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Optional default GA4 property ID
GA4_PROPERTY_ID=

# Runtime encryption + OAuth state
FOUNDLY_ENCRYPTION_KEY=
# Optional persistent Railway Volume mount, recommended: /data
FOUNDLY_DATA_DIR=/data
CONNECTOR_OAUTH_STATE_SECRET=
# Autonomous worker cadence (minimum 60000 ms)
FOUNDLY_WORKER_INTERVAL_MS=300000

# Meta / Facebook / Instagram
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_GRAPH_VERSION=v23.0
META_SCOPES=public_profile,pages_show_list,pages_read_engagement,ads_read,ads_management,business_management
META_EXTRA_SCOPES=
META_ALLOW_UNREVIEWED_SCOPES=false
META_WEBHOOK_VERIFY_TOKEN=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# LinkedIn
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
LINKEDIN_SCOPES=openid profile email

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic

# Automotive data providers
# Marktplaats: use only official/partner-authorized API/feed credentials.
MARKTPLAATS_API_KEY=
MARKTPLAATS_BASE_URL=
MARKTPLAATS_HEALTH_PATH=
MARKTPLAATS_AUTH_HEADER=authorization
MARKTPLAATS_AUTH_PREFIX=Bearer
MOBILE_DE_CLIENT_ID=
MOBILE_DE_CLIENT_SECRET=
AUTOSCOUT24_API_KEY=
AUTOBIZ_API_KEY=
AUTOUNCLE_API_KEY=
INDICATA_API_KEY=
OPENLANE_API_KEY=
RDW_API_KEY=
BPM_API_KEY=

# DMS / CRM
DMS_API_URL=
DMS_HEALTH_URL=
DMS_API_KEY=

# E-mail / SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Voice
VOICE_API_KEY=
VOICE_MODEL=

# Webhooks
FOUNDLY_WEBHOOK_SECRET=


