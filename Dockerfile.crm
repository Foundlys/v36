FROM node:24-alpine
WORKDIR /app
COPY package.json crm-core.js crm-event-outbox.js crm-automation-actions.js crm-objects.js crm-objects-client.js scoped-mutation.js module-access-contracts.js static-response.js crm-standalone.js crm.html crm.css crm-script.js crm-pipeline-editor.js foundly-static-copy.js foundly-locales.js foundly-i18n.js foundly-shell.js foundly-shell.css ./
ENV NODE_ENV=production PORT=3300 FOUNDLY_CRM_DATA_DIR=/data
RUN mkdir -p /data && chown -R node:node /app /data
USER node
EXPOSE 3300
CMD ["node", "crm-standalone.js"]
